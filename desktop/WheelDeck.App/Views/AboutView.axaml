<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              x:Class="WheelDeck.App.Views.AboutView">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Classes="h1" Text="About" />
    <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
    <TextBlock Text="WheelDeck turns your phone into a steering wheel for ETS2 and other driving games." TextWrapping="Wrap" />
    <TextBlock Text="Developed by fazrigading." />
    <Button Content="Source code on GitHub" Click="OnRepoClick" HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
