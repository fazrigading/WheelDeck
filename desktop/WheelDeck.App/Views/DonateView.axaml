<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              x:Class="WheelDeck.App.Views.DonateView">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Classes="h1" Text="Donate" />
    <TextBlock Classes="hint" Text="WheelDeck is free and open source. If it makes your drives better, consider supporting development." TextWrapping="Wrap" />
    <Button Classes="accent" Content="Buy Me a Coffee" Click="OnBuyMeACoffeeClick" HorizontalAlignment="Left" />
    <Button Classes="accent" Content="PayPal" Click="OnPayPalClick" HorizontalAlignment="Left" />
    <Button Classes="accent" Content="Ko-fi" Click="OnKoFiClick" HorizontalAlignment="Left" />

    <TextBlock FontSize="20" FontWeight="SemiBold" Text="About" Margin="0,12,0,0" />
    <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
    <TextBlock Text="WheelDeck turns your phone into a steering wheel for ETS2 and other driving games." TextWrapping="Wrap" />
    <TextBlock Text="Developed by fazrigading." />
    <Button Classes="accent" Content="Source code on GitHub" Click="OnRepoClick" HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
