<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WheelDeck.App.Views.ConnectionView">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Classes="h1" Text="Connection" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock VerticalAlignment="Center" Text="Status:" />
      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding StatusText}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock VerticalAlignment="Center" Text="Address:" />
      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ConnectionInfo}" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock VerticalAlignment="Center" Text="Paired device:" />
      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PairedDevice}" />
    </StackPanel>

    <Border Background="#205676" Padding="12" CornerRadius="8">
      <TextBlock Text="{Binding FirewallReminder}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
