<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              x:Class="WheelDeck.App.Views.ConnectionView">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Classes="h1" Text="Connection" />

    <Border Classes="card" Padding="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Ellipse Width="12" Height="12" VerticalAlignment="Center" Fill="{Binding StatusColor}" />
        <StackPanel Spacing="2">
          <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" />
          <TextBlock Classes="hint" Text="{Binding ConnectionInfo}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock VerticalAlignment="Center" Text="Paired device:" />
      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PairedDevice}" />
    </StackPanel>

    <Border Classes="card" Padding="12">
      <TextBlock Classes="hint" Text="{Binding FirewallReminder}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
