<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WheelDeck.App.Views.SetupView">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Classes="h1" Text="Setup" />

    <Button Classes="accent" Content="Check setup" Command="{Binding CheckCommand}" HorizontalAlignment="Left" />

    <Border Background="#205676" Padding="12" CornerRadius="8">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
